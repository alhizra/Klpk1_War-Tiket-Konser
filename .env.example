POSTGRES_USER=wtk
POSTGRES_PASSWORD=wtk
POSTGRES_DB=wtk
DATABASE_URL=postgres://wtk:wtk@postgres:5432/wtk
REDIS_URL=redis://redis:6379
PORT=3000
RATE_LIMIT=10000
RATE_WINDOW_SEC=60
DEFAULT_QUOTA=500
RESET_TOKEN=dev-reset

# --- Payment gateway ---
PAYMENT_PROVIDER=mock
PAYMENT_AUTO_CAPTURE=1
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=0

# --- Email e-ticket (WAJIB SMTP agar masuk Gmail/inbox nyata) ---
# Tanpa SMTP_*: e-ticket hanya di outbox lab → GET /api/mail/outbox
# JANGAN harapkan Ethereal masuk Gmail.
#
# Contoh Gmail (App Password, bukan password login biasa):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=0
#   SMTP_USER=akunanda@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   MAIL_FROM=WTK Ticket <akunanda@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WTK Ticket <noreply@wtk-ticket.local>
# MAIL_USE_ETHEREAL=1   # opsional: catcher uji + preview URL (bukan inbox nyata)
