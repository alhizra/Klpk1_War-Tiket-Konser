{
  "name": "war-tiket-konser",
  "version": "1.0.0",
  "private": true,
  "description": "Praktikum Scalable Systems — War Tiket Konser",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "seed": "node src/seed.js",
    "test": "node --test src/**/*.test.js",
    "test:ms": "npm test --prefix services/payment && npm test --prefix services/ticket",
    "data:generate": "node data/generate-real-seats.js",
    "data:manual": "node src/load-manual-data.js",
    "data:korea": "node data/generate-real-seats.js && node src/load-manual-data.js",
    "data:reload": "node data/generate-real-seats.js && node src/load-manual-data.js",
    "data:excel": "python data/import_excel_dataset.py --load",
    "data:init-sql": "python data/generate_init_sql.py",
    "codespace:api": "bash scripts/codespace-api.sh",
    "codespace:mobile": "bash scripts/codespace-mobile-web.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  }
}
